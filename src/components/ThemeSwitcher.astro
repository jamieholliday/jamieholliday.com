---
import SunIcon from "./SunIcon.astro";
import MoonIcon from "./MoonIcon.astro";
---

<style>
  .theme-switcher {
    position: relative;
  }

  #theme-toggle {
    appearance: none;
    width: 56px;
    height: 28px;
    background-color: light-dark(var(--pixel-indigo), var(--pixel-navy));
    border: 2px solid light-dark(var(--pixel-navy), var(--pixel-cream));
    box-shadow: 3px 3px 0px 0px
      light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.15));
    position: relative;
    cursor: pointer;
    transition: background-color 0.3s ease;

    &:after {
      content: "";
      display: block;
      width: 20px;
      height: 20px;
      background-color: light-dark(var(--pixel-cream), var(--pixel-cream));
      border: 2px solid light-dark(var(--pixel-navy), var(--pixel-navy));
      position: absolute;
      left: 2px;
      top: 2px;
      transition: transform 0.3s ease;
    }

    &:checked {
      background-color: light-dark(var(--pixel-purple), var(--pixel-teal));
    }

    &:checked:after {
      transform: translateX(26px);
    }

    &:hover {
      box-shadow: 4px 4px 0px 0px
        light-dark(rgba(0, 0, 0, 0.15), rgba(255, 255, 255, 0.2));
    }
  }

  .icon {
    position: absolute;
    pointer-events: none;
    transition:
      all 0.3s ease,
      opacity 0.3s ease;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sun-icon {
    width: 16px;
    height: 16px;
    color: light-dark(var(--pixel-navy), var(--pixel-navy));
    left: 6px;
    top: 6px;
    opacity: 0;
  }

  .moon-icon {
    width: 14px;
    height: 14px;
    color: light-dark(var(--pixel-cream), var(--pixel-cream));
    right: 7px;
    top: 7px;
    opacity: 1;
  }

  #theme-toggle:checked ~ .sun-icon {
    opacity: 1;
  }

  #theme-toggle:checked ~ .moon-icon {
    opacity: 0;
  }
</style>

<script>
  const toggle = document.getElementById(
    "theme-toggle",
  ) as HTMLInputElement | null;

  if (toggle) {
    const currentTheme = document.documentElement.getAttribute("data-theme");
    toggle.checked = currentTheme === "dark";

    toggle.addEventListener("change", (event: Event) => {
      const isChecked = (event.target as HTMLInputElement).checked;
      const theme = isChecked ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
    });
  }
</script>

<div class="theme-switcher" title="Theme Toggle">
  <label for="theme-toggle" class="sr-only">Theme toggle</label>
  <input type="checkbox" id="theme-toggle" />
  <span class="icon sun-icon" aria-hidden="true">
    <SunIcon />
  </span>
  <span class="icon moon-icon" aria-hidden="true">
    <MoonIcon />
  </span>
</div>
