<style>
  div {
    display: flex;
    gap: 0.5rem;
  }

  button {
    padding: 0.5rem 1rem;
    border: none;
    background-color: var(--button-bg, #eee);
    color: var(--button-text, #000);
    cursor: pointer;
    border-radius: 4px;
    font-size: 1rem;
  }

  button:hover {
    background-color: var(--button-bg-hover, #ddd);
  }
</style>

<script>
  const buttonGroup = document.querySelector("#theme-switcher");
  const htmlElement = document.documentElement;
  if (buttonGroup) {
    buttonGroup.addEventListener("click", (event: Event) => {
      const target = event.target as HTMLButtonElement;
      if (target && target.dataset.value) {
        htmlElement.style.colorScheme = target.dataset.value;
        const buttons = buttonGroup.querySelectorAll("button");
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", "false");
        });
        target.setAttribute("aria-pressed", "true");
      }
    });
  }
</script>

<div role="group" aria-label="Theme Switcher" id="theme-switcher">
  <button aria-pressed="false" data-value="light">Light</button>
  <button aria-pressed="false" data-value="light dark">Auto</button>
  <button aria-pressed="false" data-value="dark">Dark</button>
</div>
