---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<style>
  a {
    background-color: light-dark(var(--tag-bg-light), var(--tag-bg-dark));
    color: light-dark(var(--tag-text-light), var(--tag-text-dark));
    padding: 0.25em 0.75em;
    border: 2px solid light-dark(var(--pixel-navy), var(--pixel-cream));
    box-shadow: 3px 3px 0px 0px light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.15));
    font-weight: 700;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    display: inline-block;
    text-decoration: none;
  }
  
  a:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px 0px light-dark(rgba(0, 0, 0, 0.15), rgba(255, 255, 255, 0.2));
    text-decoration: none;
  }
</style>

<a href={`/tags/${tag}`}>{tag}</a>
