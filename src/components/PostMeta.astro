---
interface Props {
  pubDate: string;
}

const { pubDate } = Astro.props;
console.log(typeof pubDate);
const formattedDate = new Date(pubDate).toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const date = new Date(pubDate).toLocaleDateString("en-GB");
---

<p>
  <strong>Last updated:</strong>
  <time datetime={date}>{formattedDate}</time>
</p>
