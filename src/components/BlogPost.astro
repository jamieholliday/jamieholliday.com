---
import Tag from "./Tag.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
  id: string;
  title: string;
  pubDate: string;
  tags?: string[];
  description?: string;
}

const { id, title, pubDate, tags, description } = Astro.props;
---

<style>
  .blog-post-wrapper {
    margin-block-end: 3rem;
  }

  article {
    padding: 1.5rem;
    margin-block-end: 1.5rem;
  }

  article h3 {
    margin-block-end: 0.5rem;
  }

  .description {
    margin-block: 1rem;
    color: light-dark(var(--text-color-light), var(--text-color-dark));
  }
</style>

<div class="blog-post-wrapper">
  <article class="card">
    <h2><a href={`/posts/${id}`}>{title}</a></h2>
    <p class="description">{description}</p>
    <PostMeta pubDate={pubDate} />
    {
      tags && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <Tag tag={tag} />{" "}
            </li>
          ))}
        </ul>
      )
    }
  </article>

  <p><a class="button" href={`/posts/${id}`}>Read more...</a></p>
</div>
