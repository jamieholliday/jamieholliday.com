---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import Tag from "../components/Tag.astro";

interface MarkdownInstance {
  url: string;
  frontmatter: {
    title: string;
    pubDate: string;
    tags: string[];
    description: string;
  };
}

const allPosts = Object.values(
  import.meta.glob<MarkdownInstance>("./posts/*.md", { eager: true }),
);

const uniqueTags = [
  ...new Set(allPosts.map((post) => post.frontmatter.tags).flat()),
];
---

<style>
  .wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (width >= 768px) {
    .wrapper {
      flex-direction: row;
      gap: 3rem;
      align-items: flex-start;
    }

    .left {
      flex: 3;
    }

    .right {
      flex: 1;
    }
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    margin: 0;
    flex-wrap: wrap;
  }
</style>

<BaseLayout pageTitle="Home">
  <div class="wrapper">
    <div class="left">
      <h1>Latest Articles and tutorials</h1>
      {
        allPosts.map((post) => (
          <BlogPost
            url={post.url}
            title={post.frontmatter.title}
            pubDate={post.frontmatter.pubDate}
            tags={post.frontmatter.tags}
            description={post.frontmatter.description}
          />
        ))
      }
    </div>
    <div class="right">
      <h4>By category:</h4>
      <ul class="tags">
        {
          uniqueTags.map((tag) => (
            <li>
              <Tag tag={tag} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
